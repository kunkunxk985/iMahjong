    "@pizhou/rules": "*",
    "@pizhou/server-core": "*",
    "@pizhou/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "wrangler": "^3.80.0"
  }
}
