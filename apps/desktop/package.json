{
  "name": "@pizhou/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "iMahjong",
  "description": "iMahjong 邳州麻将桌面版",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:3d": "node tests/run-table3d.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "package:win": "npm run build && electron-builder --win zip --x64 && node scripts/copy-win-to-desktop.mjs",
    "package:win:portable": "npm run build && electron-builder --win portable --x64",
    "package:mac": "npm run build && electron-builder --mac --arm64 --dir && node scripts/copy-to-desktop.mjs"
  },
  "dependencies": {
    "@pizhou/rules": "*",
    "@pizhou/server-core": "*",
    "@pizhou/shared": "*",
    "@types/three": "^0.185.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.5",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.14",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.pizhou.mahjong.demo",
    "productName": "iMahjong",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
