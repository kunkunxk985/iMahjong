{
  "name": "imahjong",
  "private": true,
  "version": "0.1.0",
  "description": "iMahjong 邳州麻将四人联机桌面应用",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @pizhou/server",
    "dev:desktop": "npm run dev -w @pizhou/desktop",
    "check:architecture": "node --import tsx scripts/check-architecture.mts",
    "check:css": "node --import tsx scripts/clean-css.mts --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "node --import tsx scripts/smoke.mts",
    "verify": "npm run check:architecture && npm run check:css && npm run typecheck && npm test && npm run smoke && npm run build",
    "clean": "npm run clean -w @pizhou/desktop",
    "build": "npm run build -w @pizhou/desktop",
    "package": "npm run package:mac -w @pizhou/desktop",
    "package:win": "npm run package:win -w @pizhou/desktop",
    "package:mac": "npm run package:mac -w @pizhou/desktop",
    "deploy:cf": "npm run deploy -w @pizhou/worker",
    "test": "npm run test --workspaces --if-present && npm run test:root",
    "test:root": "node --import tsx --test \"tests/e2e/*.test.ts\" \"tests/challenger-*.test.ts\" \"packages/shared/test/*.test.ts\" \"packages/server-core/test/*.test.ts\"",
    "dev": "npm run dev:desktop"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron@33.4.5": true,
    "electron@44.7.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
